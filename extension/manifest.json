{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.0.0",
  "description": "Завантаження відео та аудіо з YouTube і YouTube Music для офлайн-перегляду",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies", "sidePanel", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "*://*.youtube.com/*",
    "*://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "content/ui/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content/ui/menu.js", "content/content.js"],
      "css": ["content/content.css", "content/ui/menu.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/ui/*"],
      "matches": ["*://*.youtube.com/*", "*://music.youtube.com/*"]
    }
  ]
}
